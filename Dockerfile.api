# Dockerfile.api: FastAPI backend (models, log insights, LangGraph assistant)
FROM python:3.12-slim

# Work inside /app in the container
WORKDIR /app

# Install Python packages first so this layer is cached between builds
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# NLTK resources the log cleaner needs
RUN python -m nltk.downloader punkt punkt_tab stopwords wordnet

# Application code (models, data, and chroma_db are mounted by docker-compose)
COPY agent.py api.py ./

# FastAPI port
EXPOSE 8000

# Start the API, listening on all interfaces so other containers can reach it
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
